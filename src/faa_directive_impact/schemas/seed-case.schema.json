{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.faa-directive-impact.dev/seed-case.schema.json",
  "title": "Feasibility seed case",
  "description": "One synthetic engine, one source snapshot, and the expected directive-impact outcome with its evidence and label provenance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "title",
    "slice",
    "severity",
    "label",
    "source_snapshot",
    "asset_snapshot",
    "directive_candidates",
    "expected",
    "forbidden_claims"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "case_id": {
      "type": "string",
      "pattern": "^seed-[0-9]{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "slice": {
      "enum": [
        "exact_match",
        "unaffected_part",
        "out_of_family",
        "missing_state",
        "effective_date",
        "shop_visit_trigger",
        "cycle_limit",
        "multiple_directives",
        "superseded_or_corrected",
        "missing_incorporated_material"
      ]
    },
    "severity": {
      "description": "Cost of a wrong answer: critical means a missed affected engine or a false clearance.",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ]
    },
    "label": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provenance",
        "status",
        "labeled_by",
        "labeled_on"
      ],
      "properties": {
        "provenance": {
          "enum": [
            "deterministic",
            "engineer_interpreted",
            "expert_required"
          ]
        },
        "status": {
          "description": "draft until the labeler has reviewed it against the cited source text.",
          "enum": [
            "draft",
            "reviewed",
            "adjudicated"
          ]
        },
        "labeled_by": {
          "type": "string",
          "minLength": 1
        },
        "labeled_on": {
          "type": "string",
          "format": "date"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation_id",
        "as_of"
      ],
      "properties": {
        "generation_id": {
          "type": "string",
          "pattern": "^gen-"
        },
        "as_of": {
          "description": "The date the question is asked; authority is judged as of this date.",
          "type": "string",
          "format": "date"
        }
      }
    },
    "asset_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "synthetic",
        "engine",
        "installed_components"
      ],
      "properties": {
        "synthetic": {
          "const": true
        },
        "engine": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "asset_id",
            "engine_serial_number",
            "engine_model",
            "snapshot_at"
          ],
          "properties": {
            "asset_id": {
              "type": "string",
              "minLength": 1
            },
            "engine_serial_number": {
              "$ref": "#/$defs/known_or_unknown_string"
            },
            "engine_model": {
              "$ref": "#/$defs/known_or_unknown_string"
            },
            "aircraft_tail_id": {
              "type": "string",
              "minLength": 1
            },
            "snapshot_at": {
              "type": "string",
              "format": "date"
            },
            "engine_cycle_readings": {
              "description": "Engine flight-cycle counter readings, used to count cycles between dates.",
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "at",
                  "engine_flight_cycles"
                ],
                "properties": {
                  "at": {
                    "type": "string",
                    "format": "date"
                  },
                  "engine_flight_cycles": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "installed_components": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "component_name",
              "part_number",
              "serial_number"
            ],
            "properties": {
              "component_name": {
                "type": "string",
                "minLength": 1
              },
              "part_number": {
                "$ref": "#/$defs/known_or_unknown_string"
              },
              "serial_number": {
                "$ref": "#/$defs/known_or_unknown_string"
              },
              "installed_at": {
                "type": "string",
                "format": "date"
              },
              "cycles_since_new": {
                "description": "Component cycles since new at the engine snapshot date, or unknown.",
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "const": "unknown"
                  }
                ]
              },
              "cycles_since_new_readings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "at",
                    "cycles_since_new"
                  ],
                  "properties": {
                    "at": {
                      "type": "string",
                      "format": "date"
                    },
                    "cycles_since_new": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          }
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "event_type",
              "at"
            ],
            "properties": {
              "event_type": {
                "enum": [
                  "shop_visit_induction",
                  "component_exposure",
                  "component_removal",
                  "component_installation",
                  "inspection",
                  "maintenance_program_revision"
                ]
              },
              "at": {
                "type": "string",
                "format": "date"
              },
              "engine_flight_cycles_at_event": {
                "type": "integer",
                "minimum": 0
              },
              "qualifies_as_engine_shop_visit": {
                "description": "Asserted per AD, because directives define an engine shop visit differently.",
                "type": "object",
                "propertyNames": {
                  "pattern": "^AD [0-9]{4}-[0-9]{2}-[0-9]{2}$"
                },
                "additionalProperties": {
                  "enum": [
                    "yes",
                    "no",
                    "unknown"
                  ]
                }
              },
              "detail": {
                "type": "string",
                "minLength": 1
              },
              "source_note": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "operator": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "air_carrier_operation": {
              "enum": [
                "yes",
                "no",
                "unknown"
              ]
            },
            "maintenance_program_revision": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "directive_candidates": {
      "description": "Federal Register document numbers the system should consider.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/document_number"
      }
    },
    "expected": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "directive",
          "classification",
          "reason",
          "required_evidence"
        ],
        "properties": {
          "directive": {
            "$ref": "#/$defs/document_number"
          },
          "controlling_ad": {
            "type": "string",
            "pattern": "^AD [0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "classification": {
            "enum": [
              "potentially_affected",
              "not_affected_for_directive",
              "needs_review",
              "outside_supported_scope"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "required_evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "document",
                "paragraph"
              ],
              "properties": {
                "document": {
                  "$ref": "#/$defs/document_number"
                },
                "paragraph": {
                  "type": "string",
                  "pattern": "^\\([a-z]+\\)(\\([0-9]+\\))?(\\([ivx]+\\))?$"
                },
                "locator": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "required_missing_facts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "action_timing": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "description"
            ],
            "properties": {
              "description": {
                "type": "string",
                "minLength": 1
              },
              "readings": {
                "description": "Competing interpretations, recorded when the label is expert_required.",
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "result"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "result": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "safe_behavior": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "computed": {
            "description": "Numbers the reference derivation must reproduce.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "latest_engine_flight_cycles": {
                "description": "Engine counter by which action is due if no qualifying shop visit intervenes.",
                "type": "integer",
                "minimum": 0
              },
              "component_cycles_remaining": {
                "description": "Cycles from the snapshot until the component reaches its listed limit; negative once past it.",
                "type": "integer"
              },
              "readings": {
                "type": "object",
                "propertyNames": {
                  "pattern": "^[A-Z]$"
                },
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "forbidden_claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "notes": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "label": {
            "properties": {
              "provenance": {
                "const": "expert_required"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "expected": {
            "items": {
              "properties": {
                "classification": {
                  "const": "needs_review"
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "document_number": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{5}$"
    },
    "known_or_unknown_string": {
      "type": "string",
      "minLength": 1
    }
  }
}
