{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ad_number",
    "final_rule_document",
    "governing_document",
    "corrections",
    "effective_date",
    "applicability",
    "affected_parts",
    "eligible_parts",
    "required_actions",
    "installation_prohibitions",
    "definitions",
    "amoc_paragraph",
    "ambiguities",
    "notes"
  ],
  "properties": {
    "ad_number": {
      "type": "string"
    },
    "final_rule_document": {
      "type": "string"
    },
    "governing_document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document",
        "reason"
      ],
      "properties": {
        "document": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "corrections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "document",
          "paragraph",
          "original_text",
          "corrected_text"
        ],
        "properties": {
          "document": {
            "type": "string"
          },
          "paragraph": {
            "type": "string"
          },
          "original_text": {
            "type": "string"
          },
          "corrected_text": {
            "type": "string"
          }
        }
      }
    },
    "effective_date": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "paragraph"
      ],
      "properties": {
        "date": {
          "type": "string"
        },
        "paragraph": {
          "type": "string"
        }
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine_models",
        "models_paragraph",
        "part_condition"
      ],
      "properties": {
        "engine_models": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "models_paragraph": {
          "type": "string"
        },
        "part_condition": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "component",
            "part_numbers",
            "paragraph"
          ],
          "properties": {
            "component": {
              "type": "string"
            },
            "part_numbers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "paragraph": {
              "type": "string"
            }
          }
        }
      }
    },
    "affected_parts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "component",
          "part_number",
          "serial_number",
          "removal_limit_cycles_since_new",
          "paragraph"
        ],
        "properties": {
          "component": {
            "type": "string"
          },
          "part_number": {
            "type": "string"
          },
          "serial_number": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "removal_limit_cycles_since_new": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "paragraph": {
            "type": "string"
          }
        }
      }
    },
    "eligible_parts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "component",
          "part_numbers",
          "description",
          "paragraph"
        ],
        "properties": {
          "component": {
            "type": "string"
          },
          "part_numbers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": {
            "type": "string"
          },
          "paragraph": {
            "type": "string"
          }
        }
      }
    },
    "required_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "paragraph",
          "description",
          "applies_to",
          "trigger",
          "shop_visit_definition_paragraph",
          "condition_description",
          "condition_definition_paragraph",
          "limits",
          "combination"
        ],
        "properties": {
          "paragraph": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "applies_to": {
            "type": "string",
            "enum": [
              "listed_parts",
              "part_condition_parts",
              "engine",
              "other"
            ]
          },
          "trigger": {
            "type": "string",
            "enum": [
              "next_shop_visit_after_effective_date",
              "next_shop_visit_after_effective_date_with_condition",
              "compliance_time_only",
              "other"
            ]
          },
          "shop_visit_definition_paragraph": {
            "type": "string"
          },
          "condition_description": {
            "type": "string"
          },
          "condition_definition_paragraph": {
            "type": "string"
          },
          "limits": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "value"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "listed_part_cycles_since_new",
                    "flight_cycles_after_effective_date",
                    "days_after_effective_date",
                    "other"
                  ]
                },
                "value": {
                  "anyOf": [
                    {
                      "type": "integer"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          },
          "combination": {
            "type": "string",
            "enum": [
              "single",
              "whichever_occurs_later",
              "whichever_occurs_first",
              "unclear"
            ]
          }
        }
      }
    },
    "installation_prohibitions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "paragraph",
          "description",
          "applies_to"
        ],
        "properties": {
          "paragraph": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "applies_to": {
            "type": "string",
            "enum": [
              "listed_parts",
              "part_condition_parts",
              "other"
            ]
          }
        }
      }
    },
    "definitions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "term",
          "paragraph"
        ],
        "properties": {
          "term": {
            "type": "string"
          },
          "paragraph": {
            "type": "string"
          }
        }
      }
    },
    "amoc_paragraph": {
      "type": "string"
    },
    "ambiguities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "paragraph",
          "description",
          "readings"
        ],
        "properties": {
          "paragraph": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "readings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
